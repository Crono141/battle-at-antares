[configuration]

entry_symbol = "antares_library_init"
compatibility_minimum = "4.7"
reloadable = false

[libraries]

linux.debug.x86_64 = "res://bin/libantares.so"
linux.release.x86_64 = "res://bin/libantares.so"
windows.debug.x86_64 = "res://bin/antares.dll"
windows.release.x86_64 = "res://bin/antares.dll"
