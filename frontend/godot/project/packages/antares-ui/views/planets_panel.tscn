[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://packages/antares-ui/views/planets_panel.gd" id="1"]

[node name="PlanetsPanel" type="PanelContainer"]
offset_right = 800.0
offset_bottom = 600.0
theme_type_variation = &"Pane"
script = ExtResource("1")

[node name="Box" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Header" type="HBoxContainer" parent="Box"]
layout_mode = 2

[node name="Title" type="Label" parent="Box/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"Heading"
text = "Planets"

[node name="Close" type="Button" parent="Box/Header"]
custom_minimum_size = Vector2(34, 30)
layout_mode = 2
size_flags_vertical = 0
tooltip_text = "Close (Esc)"
focus_mode = 0
text = "X"

[node name="Filters" type="HFlowContainer" parent="Box"]
layout_mode = 2
theme_override_constants/h_separation = 6
theme_override_constants/v_separation = 6

[node name="Table" type="VBoxContainer" parent="Box"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 4

[node name="Columns" type="HBoxContainer" parent="Box/Table"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="Scroll" type="ScrollContainer" parent="Box/Table"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Rows" type="VBoxContainer" parent="Box/Table/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 4

[node name="Hint" type="Label" parent="Box"]
layout_mode = 2
theme_type_variation = &"Dim"
horizontal_alignment = 1
text = ""

[node name="Send" type="HBoxContainer" parent="Box"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Colony" type="Button" parent="Box/Send"]
custom_minimum_size = Vector2(0, 34)
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "Arm, then click a planet: the nearest free colony ship goes there"
focus_mode = 0
toggle_mode = true
text = "SEND COLONY SHIP"

[node name="Outpost" type="Button" parent="Box/Send"]
custom_minimum_size = Vector2(0, 34)
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "Arm, then click a planet: the nearest free outpost ship goes there"
focus_mode = 0
toggle_mode = true
text = "SEND OUTPOST SHIP"
