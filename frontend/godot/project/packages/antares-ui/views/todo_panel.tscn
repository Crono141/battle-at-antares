[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://packages/antares-ui/views/todo_panel.gd" id="1"]
[ext_resource type="Script" path="res://packages/antares-ui/views/fit_scroll.gd" id="fit"]

[node name="TodoPanel" type="PanelContainer"]
custom_minimum_size = Vector2(400, 0)
offset_right = 400.0
offset_bottom = 40.0
theme_type_variation = &"Pane"
script = ExtResource("1")

[node name="Fit" type="ScrollContainer" parent="."]
layout_mode = 2
horizontal_scroll_mode = 0
script = ExtResource("fit")

[node name="Box" type="VBoxContainer" parent="Fit"]
