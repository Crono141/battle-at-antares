/* WP3.0 trial path B. Units: dp (density-independent pixels). RmlUi has no built-in
   stylesheet, so block elements are declared here. */
div, h1, p {
    display: block;
}

body {
    width: 100%;
    height: 100%;
    font-family: Roboto;
    font-size: 15dp;
    color: #dde3ee;
    pointer-events: none;
}

#labels {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
}

.label {
    position: absolute;
    width: 160dp;
    text-align: center;
    font-size: 15dp;
    color: #d9e0f2;
    font-effect: outline(1dp #000000);
}

#bar {
    position: absolute;
    left: 8dp;
    top: 8dp;
    pointer-events: auto;
}

#stats {
    margin-left: 14dp;
    color: #b3bfcc;
    font-effect: outline(1dp #000000);
}

button {
    display: inline-block;
    padding: 5dp 10dp;
    background-color: #2a2f38;
    border: 1dp #4a5361;
    border-radius: 3dp;
    color: #e6eaf0;
    cursor: pointer;
    pointer-events: auto;
}

button:hover {
    background-color: #3a4250;
}

button:active {
    background-color: #1d2128;
}

#panel {
    display: none;
    position: absolute;
    right: 16dp;
    top: 56dp;
    width: 260dp;
    padding: 12dp 14dp;
    background-color: #1a1d22f0;
    border: 1dp #3a4250;
    border-radius: 4dp;
    pointer-events: auto;
}

#panel.open {
    display: block;
}

#panel h1 {
    font-size: 24dp;
    margin-bottom: 8dp;
}

#panel p {
    margin-bottom: 6dp;
}

#panel .buttons {
    text-align: right;
    margin-top: 6dp;
}
